<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="pinakes_dynamic_filter_template_product_product_borderless_1" name="Pinakes Borderless Product n°1"
              inherit_id="website_sale.dynamic_filter_template_product_product_borderless_1">
        <xpath expr="//div[hasclass('card-title')]" position="attributes">
            <attribute name="t-field">record.product_tmpl_id.display_name</attribute>
        </xpath>
    </template>

    <template id="pinakes_dynamic_filter_template_product_product_borderless_2" name="Pinakes Borderless Product n°2"
              inherit_id="website_sale.dynamic_filter_template_product_product_borderless_2">
        <xpath expr="//div[hasclass('card-title')]" position="attributes">
            <attribute name="t-field">record.product_tmpl_id.display_name</attribute>
        </xpath>
        <xpath expr="//div[hasclass('card-title')]" position="after">
            <t t-call="pinakes_website.pinakes_products_item"/>
        </xpath>
        <xpath expr="//button[hasclass('js_add_cart')]" position="attributes">
            <attribute name="class" remove="js_add_cart" add="show_variants" separator=" "/>
        </xpath>
    </template>

