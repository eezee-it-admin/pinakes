<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="payment" inherit_id="website_sale.payment">

        <xpath expr="//t[@name='website_sale_non_free_cart']/div[@t-else]" position="replace">
            <div t-elif="not providers and not tokens" class="alert alert-warning">
                <strong>Your order has been registered and will be processed as soon as possible.</strong>
                <br/>
            </div>
        </xpath>
    </template>

</odoo>
